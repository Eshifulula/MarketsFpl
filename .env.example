# Copy to `.env` (git-ignored) and fill in locally. NEVER commit real values: this repo is PUBLIC.
# Every value below is a placeholder.

# --- Safety (defaults are the safe ones) -----------------------------------------------------
# Master switch for changing your real FPL team. Leave false until you have run a dry run.
FPL_ALLOW_WRITES=false
# Operator PIN typed ONLY on the local approval page. >= 8 chars. Required to approve anything.
FPL_APPROVAL_PIN=
# Opt-in exception that lets a VERIFIED emergency lineup swap (last 15 minutes before the deadline)
# run WITHOUT your approval. Leave false unless you understand docs/SECURITY_MODEL.md.
FPL_ALLOW_EMERGENCY=false
FPL_EMERGENCY_MAX_PER_GAMEWEEK=2
FPL_PIN_MAX_FAILURES=5
FPL_PIN_LOCKOUT_SECONDS=900
FPL_MAX_TRANSFERS_PER_PROPOSAL=3
FPL_MAX_POINTS_HIT=4
FPL_PROPOSAL_TTL_SECONDS=900
FPL_EXECUTE_WINDOW_SECONDS=600
FPL_AUDIT_DIR=audit

# --- Transport -------------------------------------------------------------------------------
# stdio (local Claude Desktop) or streamable-http (needs the bearer token below)
FPL_MCP_TRANSPORT=stdio
# >= 32 random chars, e.g. generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FPL_MCP_BEARER_TOKEN=

# --- Network (loopback by default; do not expose these ports publicly) -----------------------
FPL_WEB_HOST=127.0.0.1
FPL_AUTH_PORT=8020
FPL_MCP_HOST=127.0.0.1
FPL_MCP_PORT=8021

# Host allow-lists (comma separated). Add your tunnel hostname here when deploying - see docs/DEPLOY.md
# FPL_WEB_ALLOWED_HOSTS=127.0.0.1:8020,localhost:8020
# FPL_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*
# FPL_MCP_ALLOWED_ORIGINS=http://127.0.0.1:*,http://localhost:*
# Base URL shown to you in approval links (must be reachable only by you)
# FPL_AUTH_BASE_URL=http://127.0.0.1:8020
# Only inside a container whose published ports are bound to the host's loopback:
# FPL_ALLOW_NONLOOPBACK_BIND=false
