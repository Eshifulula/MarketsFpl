# INERT TEMPLATE - this file is NOT under .github/workflows/, so GitHub never runs it.
#
# Do not enable until the repository is PRIVATE. Enabling it means adding deployment secrets to the
# repo, and this project's rule is: no VPS details or secrets while the repo is public.
# See docs/DEPLOY.md for the full checklist.
#
# To enable (after going private):
#   1. Settings -> Environments -> create "production" with required reviewers.
#   2. Add environment secrets VPS_HOST, VPS_USER, VPS_SSH_KEY (restricted deploy key), VPS_KNOWN_HOSTS.
#   3. Settings -> Variables -> add DEPLOY_ENABLED=true.
#   4. Copy this file to .github/workflows/deploy.yml.

name: Deploy

on:
  workflow_dispatch: # manual only; never on push

permissions:
  contents: read

jobs:
  deploy:
    if: ${{ vars.DEPLOY_ENABLED == 'true' }}
    runs-on: ubuntu-latest
    environment: production
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          persist-credentials: false
      - name: Build image
        run: docker build --pull -t markets-fpl:${{ github.sha }} .
      - name: Ship image over SSH (no registry, nothing published)
        env:
          VPS_HOST: ${{ secrets.VPS_HOST }}
          VPS_USER: ${{ secrets.VPS_USER }}
          VPS_SSH_KEY: ${{ secrets.VPS_SSH_KEY }}
          VPS_KNOWN_HOSTS: ${{ secrets.VPS_KNOWN_HOSTS }}
        run: |
          install -m 700 -d ~/.ssh
          printf '%s\n' "$VPS_SSH_KEY" > ~/.ssh/id_deploy && chmod 600 ~/.ssh/id_deploy
          printf '%s\n' "$VPS_KNOWN_HOSTS" > ~/.ssh/known_hosts
          docker save markets-fpl:${{ github.sha }} \
            | ssh -i ~/.ssh/id_deploy -o StrictHostKeyChecking=yes "$VPS_USER@$VPS_HOST" \
                "docker load && docker tag markets-fpl:${{ github.sha }} markets-fpl:current"
          # The restart script on the VPS owns the runtime secrets (FPL_APPROVAL_PIN,
          # FPL_MCP_BEARER_TOKEN). They are never passed through GitHub.
          ssh -i ~/.ssh/id_deploy -o StrictHostKeyChecking=yes "$VPS_USER@$VPS_HOST" \
            "/opt/markets-fpl/restart.sh"
